# Runtime v0 — single-user configuration.
# Copy to .env.local for development.

# --- Provider selection -----------------------------------------------------
# `local` executes workspaces in a directory on this machine (no Modal spend).
# `modal` executes them in Modal sandboxes.
RUNTIME_PROVIDER=local
# Required for same-origin protection on workspace and lifecycle mutations.
RUNTIME_BASE_URL=http://localhost:3000
# Where the local provider stores workspaces. Set a durable, app-private
# directory (mode 0700) for deployments; the $TMPDIR default is development-only.
# RUNTIME_LOCAL_ROOT=

# --- Sandbox preview mode ---------------------------------------------------
# The sandbox preview panel embeds the app in a cross-site iframe. The tunnel's
# auth cookie is SameSite=Lax, so /_next/static/** subresources are blocked and
# the page renders unstyled. `experimental.inlineCss` fixes that, but only
# applies to production builds — so the preview defaults to build + start.
#
# Set to `dev` for hot reload while iterating (accepting that the embedded panel
# will look unstyled; open the tunnel in a top-level tab instead).
RUNTIME_PREVIEW_MODE=production

# --- Single-user guard ------------------------------------------------------
# REQUIRED: only this GitHub login may sign in. Runtime is deliberately
# one-user; leaving it blank rejects every sign-in attempt.
RUNTIME_OWNER_GITHUB_LOGIN=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub -----------------------------------------------------------------
# OAuth (via Supabase) provides identity only. This must be a fine-grained PAT
# owned by RUNTIME_OWNER_GITHUB_LOGIN, authorized for SSO organizations, and
# restricted to the repositories Runtime should manage. It needs Metadata read
# for M2 and Contents read for M3 workspace cloning. Later push/PR features
# add their own write permissions.
# It is server-only — never prefix it with NEXT_PUBLIC_ or commit it.
GITHUB_PAT=

# --- Linear -----------------------------------------------------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- Modal ------------------------------------------------------------------
# M4 creates a named persistent Volume and a disposable 24-hour Sandbox for
# each workspace. Create these credentials with the Modal CLI and keep both
# server-only; Runtime injects them only into Next.js orchestration.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=runtime

# --- Claude Code ------------------------------------------------------------
# Use exactly one. ANTHROPIC_API_KEY bills the API; CLAUDE_CODE_OAUTH_TOKEN
# (from `claude setup-token`) draws on the subscription's Agent SDK credit.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
